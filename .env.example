# ==============================================================================
# Power BI QA Testing Suite - Environment Configuration
# ==============================================================================

# Set to "false" to enable real Microsoft / Azure AD authentication and live Power BI REST APIs
# Set to "true" for offline demo/simulation mode
MOCK_SERVICE=true

# Azure Active Directory (Entra ID) App Registration
# Required when MOCK_SERVICE=false
CLIENT_ID=your_azure_client_id_here
CLIENT_SECRET=your_azure_client_secret_here
TENANT_ID=your_azure_tenant_id_here

# Secret key for sessions
SECRET_KEY=pbi-qa-suite-secret-key-12345

# Supabase authentication (public project values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Session Pooler URI (backend only; contains a private database password)
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres

# Frontend build-time Supabase authentication values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
